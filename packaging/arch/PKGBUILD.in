# Generated by packaging/make_source.py with the release archive SHA-256.
pkgname=mirivue-gnome
pkgver=@VERSION@
pkgrel=1
pkgdesc='Gestionnaire de fichiers et de médias GNOME à deux panneaux'
arch=('any')
url='https://github.com/denamiel/Mirivue-gnome'
license=('custom:Mirivue-Pending')
depends=('python>=3.11' 'python-gobject' 'python-cairo' 'python-pillow' 'python-mutagen'
         'gtk4>=4.12' 'libadwaita>=1.4' 'gnome-desktop-4' 'poppler-glib'
         'hicolor-icon-theme' 'gvfs' 'ffmpeg' 'mediainfo' 'gst-plugins-good')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel' 'desktop-file-utils')
checkdepends=('xorg-server-xvfb' 'xorg-xauth' 'dbus')
optdepends=('gvfs-smb: partages SMB' 'libpulse: choix de la sortie audio via pactl'
            'perl-image-exiftool: écriture des métadonnées compatibles'
            'mkvtoolnix-cli: métadonnées et sous-titres Matroska'
            'gst-libav: codecs multimédias supplémentaires')
source=("$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('@SHA256@')

build() {
  cd "$pkgname-$pkgver"
  /usr/bin/python3 -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  dbus-run-session -- xvfb-run -a bash packaging/verify.sh
}

package() {
  cd "$pkgname-$pkgver"
  /usr/bin/python3 -m installer --destdir="$pkgdir" dist/*.whl
  desktop-file-validate "$pkgdir/usr/share/applications/org.pdenams.Mirivue.Gtk4.desktop"
  install -Dm644 packaging/LICENCE-A-CONFIRMER.md "$pkgdir/usr/share/licenses/$pkgname/LICENCE-A-CONFIRMER.md"
}
